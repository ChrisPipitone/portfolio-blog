---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

const assetImages = import.meta.glob<{ default: ImageMetadata }>(
  "/src/assets/images/**/*.{jpg,jpeg,png,webp,avif,svg}",
  { eager: true }
);

interface Props {
  title: string;
  description: string;
  tags: string[];
  href: string;
  index: number;
  image?: string;
  status?: "wip" | "shipped" | "archived" | "abandoned" | "hold";
}

const { title, description, tags, href, index, image, status } = Astro.props;

// `image` is either a /src/assets path (build-optimised) or a /public path (served as-is).
const asset = image ? assetImages[image]?.default : undefined;
const publicSrc = !asset && image?.startsWith("/") ? image : undefined;
---

<article class="slab">
  <div class="slab__media">
    <span class="slab__plate"></span>
    <a class="slab__frame" href={href} tabindex="-1" aria-hidden="true">
      {asset && <Image src={asset} alt="" loading="lazy" />}
      {publicSrc && <img src={publicSrc} alt="" loading="lazy" />}
      {!asset && !publicSrc && <span class="slab__ph">No media yet</span>}
    </a>
  </div>

  <div class="slab__body">
    <div class="slab__top">
      <span class="slab__num">{String(index + 1).padStart(2, "0")}</span>
      {status && <span class={`badge badge--${status}`}>{status}</span>}
    </div>

    <h3 class="slab__title"><a href={href}>{title}</a></h3>
    <p class="slab__desc">{description}</p>

    <ul class="slab__tags">
      {tags.map((tag) => <li>{tag}</li>)}
    </ul>

    <a class="slab__more" href={href}>Read the writeup →</a>
  </div>
</article>

<style>
  .slab {
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    gap: 4rem;
    align-items: center;
    padding: 4rem 0;
    border-top: 1px solid var(--color-line);
  }

  .slab:nth-of-type(even) .slab__media { order: 2; }

  @media (max-width: 880px) {
    .slab { grid-template-columns: 1fr; gap: 1.75rem; padding: 2.75rem 0; }
    .slab:nth-of-type(even) .slab__media { order: 0; }
  }

  .slab__media { position: relative; }

  .slab__plate {
    position: absolute;
    inset: 1.1rem -1.1rem -1.1rem 1.1rem;
    background: var(--color-accent);
    opacity: 0.09;
  }

  .slab__frame {
    position: relative;
    display: grid;
    place-items: center;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background: var(--color-panel);
    border: 1px solid var(--color-line);
  }

  .slab__frame :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .slab__ph {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-muted);
  }

  .slab__top {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .slab__num {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--color-accent);
    letter-spacing: 0.1em;
  }

  .slab__title {
    font-size: clamp(1.75rem, 3.6vw, 2.4rem);
    letter-spacing: -0.03em;
    margin: 0.6rem 0 0.8rem;
    line-height: 1.08;
  }

  .slab__title a { color: var(--color-heading); }
  .slab__title a:hover { color: var(--color-accent); }

  .slab__desc {
    margin: 0 0 1.25rem;
    max-width: 32rem;
    color: var(--color-text);
  }

  .slab__tags {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin: 0 0 1.6rem;
    padding: 0;
  }

  .slab__tags li {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    background: var(--color-raised);
    border: 1px solid var(--color-line);
    color: var(--color-muted);
    padding: 0.18rem 0.5rem;
    border-radius: 4px;
  }

  .slab__more {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    color: var(--color-accent);
    border-bottom: 1px solid var(--color-accent-line);
    padding-bottom: 3px;
  }

  .slab__more:hover { border-bottom-color: var(--color-accent); }
</style>
