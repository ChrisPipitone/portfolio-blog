---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

const assetImages = import.meta.glob<{ default: ImageMetadata }>(
  "/src/assets/images/**/*.{jpg,jpeg,png,webp,avif,svg}",
  { eager: true }
);

interface Props {
  title: string;
  description: string;
  tags: string[];
  href: string;
  github?: string;
  image?: string;
  status?: "wip" | "shipped" | "archived" | "abandoned" | "hold";
}

const { title, description, tags, href, github, image, status } = Astro.props;

const asset = image ? assetImages[image]?.default : undefined;
const publicSrc = !asset && image?.startsWith("/") ? image : undefined;
---

<article class="card">
  <a class="card__media" href={href} tabindex="-1" aria-hidden="true">
    {asset && <Image src={asset} alt="" loading="lazy" />}
    {publicSrc && <img src={publicSrc} alt="" loading="lazy" />}
    {!asset && !publicSrc && <span class="card__ph">No media yet</span>}
    {status && <span class={`badge badge--${status} card__badge`}>{status}</span>}
  </a>

  <div class="card__body">
    <h3 class="card__title"><a href={href}>{title}</a></h3>
    <p class="card__desc">{description}</p>

    <ul class="card__tags">
      {tags.map((tag) => <li>{tag}</li>)}
    </ul>

    {github && (
      <a class="card__github" href={github} target="_blank" rel="noopener noreferrer">↗ GitHub</a>
    )}
  </div>
</article>

<style>
  .card {
    display: flex;
    flex-direction: column;
    background: var(--color-panel);
    border: 1px solid var(--color-line);
    border-radius: 12px;
    overflow: hidden;
    transition: border-color 140ms ease, transform 140ms ease;
  }

  .card:hover {
    border-color: var(--color-line-2);
    transform: translateY(-2px);
  }

  .card__media {
    position: relative;
    display: grid;
    place-items: center;
    aspect-ratio: 16 / 10;
    background: var(--color-raised);
    overflow: hidden;
    border-bottom: 1px solid var(--color-line);
  }

  .card__media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .card__ph {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-muted);
  }

  .card__badge {
    position: absolute;
    top: 0.6rem;
    right: 0.6rem;
  }

  .card__body {
    padding: 1.1rem 1.15rem 1.25rem;
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  .card__title {
    font-size: 1.125rem;
    margin: 0 0 0.4rem;
  }

  .card__title a { color: var(--color-heading); }
  .card__title a:hover { color: var(--color-accent); }

  .card__desc {
    margin: 0 0 1rem;
    font-size: 0.9375rem;
    color: var(--color-muted);
    line-height: 1.6;
    flex: 1;
  }

  .card__tags {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    margin: 0;
    padding: 0;
  }

  .card__tags li {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    background: var(--color-raised);
    border: 1px solid var(--color-line);
    color: var(--color-muted);
    padding: 0.15rem 0.45rem;
    border-radius: 4px;
  }

  .card__github {
    margin-top: 1rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
  }
</style>
