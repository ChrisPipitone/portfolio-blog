---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

const allImages = import.meta.glob<{ default: ImageMetadata }>(
  "/src/assets/images/**/*.{jpg,jpeg,png,webp,avif,svg}",
  { eager: true }
);

interface Props {
  title: string;
  description: string;
  tags: string[];
  href: string;
  github?: string;
  image?: string;
  status?: "wip" | "shipped" | "archived";
}

const { title, description, tags, href, github, image, status } = Astro.props;
const imageData = image ? allImages[image]?.default : undefined;
---

<article class="card">
  {imageData && (
    <a href={href} class="card__image-link" tabindex="-1" aria-hidden="true">
      <Image src={imageData} alt={title} class="card__image" loading="lazy" />
    </a>
  )}

  <div class="card__body">
    <div class="card__header">
      <h3 class="card__title">
        <a href={href}>{title}</a>
      </h3>
      {status === "wip" && <span class="card__badge card__badge--wip">WIP</span>}
      {status === "archived" && <span class="card__badge card__badge--archived">Archived</span>}
    </div>

    <p class="card__description">{description}</p>

    <footer class="card__footer">
      <div class="card__tags">
        {tags.map((tag) => (
          <span class="card__tag">{tag}</span>
        ))}
      </div>

      {github && (
        <a
          href={github}
          class="card__github"
          target="_blank"
          rel="noopener noreferrer"
          aria-label={`View ${title} on GitHub`}
        >
          ↗ GitHub
        </a>
      )}
    </footer>
  </div>
</article>

<style>
  .card {
    background-color: var(--color-bg-card);
    border: 1px solid var(--color-border);
    border-top: 3px solid var(--color-accent);
    border-radius: 6px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    box-shadow: var(--shadow-card);
    transition: box-shadow 0.2s ease, transform 0.2s ease;
    position: relative;
  }

  .card:hover {
    box-shadow: var(--shadow-card-hover);
    transform: translateY(-2px);
  }

  .card__image-link {
    display: block;
  }

  .card__image {
    width: 100%;
    height: 10rem;
    object-fit: cover;
    display: block;
  }

  .card__body {
    padding: 1.25rem 1.25rem 1rem;
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  .card__header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 0.5rem;
    margin-bottom: 0.5rem;
  }

  .card__title {
    font-family: var(--font-body);
    font-size: 1rem;
    font-weight: 600;
    line-height: 1.2;
    letter-spacing: -0.01em;
  }

  .card__title a {
    color: var(--color-text-heading);
  }

  .card__title a::after {
    content: "";
    position: absolute;
    inset: 0;
  }

  .card__title a:hover {
    color: var(--color-accent);
  }

  .card__badge {
    font-family: var(--font-body);
    font-size: 0.5625rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    padding: 0.2rem 0.5rem;
    border-radius: 100px;
    white-space: nowrap;
    flex-shrink: 0;
    position: relative;
    z-index: 1;
    margin-top: 0.1rem;
  }

  .card__badge--wip {
    background-color: var(--color-badge-wip-bg);
    color: var(--color-badge-wip-text);
  }

  .card__badge--archived {
    background-color: var(--color-tag-bg);
    color: var(--color-text-muted);
  }

  .card__description {
    font-family: var(--font-body);
    font-size: 0.8125rem;
    line-height: 1.65;
    color: var(--color-text-muted);
    margin-bottom: 1rem;
    flex: 1;
  }

  .card__footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 0.5rem;
  }

  .card__tags {
    display: flex;
    gap: 0.375rem;
    flex-wrap: wrap;
  }

  .card__tag {
    font-family: var(--font-body);
    font-size: 0.625rem;
    font-weight: 500;
    letter-spacing: 0.04em;
    background-color: var(--color-tag-bg);
    color: var(--color-tag-text);
    padding: 0.2rem 0.5rem;
    border-radius: 100px;
  }

  .card__github {
    font-family: var(--font-body);
    font-size: 0.75rem;
    color: var(--color-accent);
    white-space: nowrap;
    flex-shrink: 0;
    position: relative;
    z-index: 1;
  }

  .card__github:hover {
    color: var(--color-accent-hover);
  }
</style>
