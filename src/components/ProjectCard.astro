---
interface Props {
  title: string;
  description: string;
  tags: string[];
  href: string;
  github?: string;
  image?: string;
}

const { title, description, tags, href, github, image } = Astro.props;
---

<article class="card">
  {image && (
    <a href={href} class="card__image-link" tabindex="-1" aria-hidden="true">
      <img src={image} alt={title} class="card__image" loading="lazy" />
    </a>
  )}

  <div class="card__body">
    <h3 class="card__title">
      <a href={href}>{title}</a>
    </h3>
    <p class="card__description">{description}</p>

    <footer class="card__footer">
      <div class="card__tags">
        {tags.map((tag) => (
          <span class="card__tag">{tag}</span>
        ))}
      </div>

      {github && (
        <a
          href={github}
          class="card__github"
          target="_blank"
          rel="noopener noreferrer"
          aria-label={`View ${title} on GitHub`}
        >
          ↗ GitHub
        </a>
      )}
    </footer>
  </div>
</article>

<style>
  .card {
    background-color: var(--color-bg-card);
    border: 1px solid var(--color-border);
    border-left: 3px solid var(--color-accent);
    border-radius: 6px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    transition: border-color 0.15s ease;
  }

  .card:hover {
    border-color: var(--color-accent);
  }

  .card__image-link {
    display: block;
  }

  .card__image {
    width: 100%;
    height: 10rem;
    object-fit: cover;
    display: block;
  }

  .card__body {
    padding: 1rem 1.125rem;
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  .card__title {
    font-family: var(--font-heading);
    font-size: 0.9375rem;
    font-weight: 700;
    margin-bottom: 0.375rem;
  }

  .card__title a {
    color: var(--color-text-heading);
  }

  .card__title a:hover {
    color: var(--color-accent);
  }

  .card__description {
    font-family: var(--font-body);
    font-size: 0.8125rem;
    line-height: 1.6;
    color: var(--color-text-muted);
    margin-bottom: 0.875rem;
    flex: 1;
  }

  .card__footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 0.5rem;
  }

  .card__tags {
    display: flex;
    gap: 0.3rem;
    flex-wrap: wrap;
  }

  .card__tag {
    font-family: var(--font-body);
    font-size: 0.5625rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    background-color: var(--color-tag-bg);
    color: var(--color-tag-text);
    padding: 0.15rem 0.4rem;
    border-radius: 2px;
  }

  .card__github {
    font-family: var(--font-body);
    font-size: 0.75rem;
    color: var(--color-accent);
    white-space: nowrap;
    flex-shrink: 0;
  }

  .card__github:hover {
    color: var(--color-accent-hover);
  }
</style>
