---
import { site } from "../config/site";
---

<section class="hero">
  <div class="hero__photo">
    <img src={site.portrait} alt={site.name} width="800" height="1000" />
    <span class="hero__tick hero__tick--tl"></span>
    <span class="hero__tick hero__tick--br"></span>
  </div>

  <div class="hero__text">
    <p class="hero__eyebrow">{site.tagline}</p>
    <h1 class="hero__title">I'm just some jabroni who codes.</h1>
    <p class="hero__bio">{site.bio}</p>
    <p class="hero__sub">{site.subline}</p>
  </div>
</section>

<style>
  .hero {
    max-width: var(--content-width);
    margin: 0 auto;
    padding: 4.5rem 2rem 5.5rem;
    display: grid;
    grid-template-columns: 0.85fr 1.15fr;
    gap: 4.5rem;
    align-items: center;
  }

  @media (max-width: 900px) {
    .hero {
      grid-template-columns: 1fr;
      gap: 2.5rem;
      padding: 3rem 1.5rem 4rem;
    }
  }

  .hero__photo {
    position: relative;
    padding: 0.75rem;
    border: 1px solid var(--color-line);
    background: var(--color-panel);
  }

  .hero__photo img {
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    filter: grayscale(0.25) contrast(1.05);
  }

  .hero__tick {
    position: absolute;
    width: 14px;
    height: 14px;
    border: 1px solid var(--color-accent);
  }

  .hero__tick--tl { top: -1px; left: -1px; border-right: 0; border-bottom: 0; }
  .hero__tick--br { bottom: -1px; right: -1px; border-left: 0; border-top: 0; }

  .hero__eyebrow {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--color-accent);
    margin: 0 0 1rem;
  }

  .hero__title {
    font-size: clamp(2.1rem, 5vw, 3.4rem);
    line-height: 1.06;
    letter-spacing: -0.035em;
    margin: 0 0 1.4rem;
  }

  .hero__bio {
    margin: 0;
    max-width: 36rem;
  }

  .hero__sub {
    margin: 0.9rem 0 0;
    max-width: 36rem;
    color: var(--color-muted);
  }

</style>
