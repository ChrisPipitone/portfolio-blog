---
import { site } from "../config/site";
import { logo, specs, swatches } from "../config/stack";
---

<section class="fetch">
  <div class="fetch__win">
    <div class="fetch__bar">
      <span class="dot"></span><span class="dot"></span><span class="dot"></span>
      <span class="fetch__title">{site.handle}@stack — fetch</span>
    </div>

    <div class="fetch__body">
      <pre class="fetch__logo" aria-hidden="true">{logo}</pre>

      <dl class="fetch__specs">
        <div class="fetch__who"><span>chris</span>@<span>stack</span></div>
        <div class="fetch__hr">────────────────────────────</div>
        {specs.map(([k, v]) => (
          <div class="fetch__row"><dt>{k}</dt><dd>{v}</dd></div>
        ))}
        <div class="fetch__swatch" aria-hidden="true">
          {swatches.map((c) => <i style={`--c:${c}`}></i>)}
        </div>
      </dl>
    </div>
  </div>
</section>

<style>
  .fetch {
    max-width: var(--content-width);
    margin: 0 auto;
    padding: 0 2rem 5.5rem;
  }

  @media (max-width: 640px) { .fetch { padding: 0 1.25rem 4rem; } }

  .fetch__win {
    background: var(--color-panel);
    border: 1px solid var(--color-line);
    border-radius: 10px;
    overflow: hidden;
  }

  .fetch__bar {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.65rem 0.9rem;
    border-bottom: 1px solid var(--color-line);
    background: var(--color-raised);
  }

  .dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: #34383e;
  }

  .fetch__title {
    margin-left: 0.7rem;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    color: var(--color-muted);
  }

  .fetch__body {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 2.5rem;
    align-items: start;
    padding: 2rem 1.75rem;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
  }

  @media (max-width: 760px) {
    .fetch__body { grid-template-columns: 1fr; gap: 1.5rem; }
  }

  .fetch__logo {
    margin: 0;
    color: var(--color-accent);
    font-family: var(--font-mono);
    font-size: 1.75rem;
    line-height: 1.08;
    white-space: pre;
  }

  @media (max-width: 760px) { .fetch__logo { font-size: 1.1rem; } }

  .fetch__specs { margin: 0; }

  .fetch__who { color: var(--color-accent); margin-bottom: 0.2rem; }
  .fetch__who span { color: var(--color-heading); font-weight: 700; }

  .fetch__hr {
    color: var(--color-line);
    margin-bottom: 0.6rem;
    overflow: hidden;
  }

  .fetch__row {
    display: grid;
    grid-template-columns: 7rem 1fr;
    gap: 0.75rem;
    padding: 0.18rem 0;
  }

  dt { color: var(--color-accent); }
  dd { margin: 0; color: var(--color-text); }

  .fetch__swatch { display: flex; gap: 0.35rem; margin-top: 1.1rem; }
  .fetch__swatch i { width: 1.6rem; height: 0.85rem; background: var(--c); display: block; }
</style>
