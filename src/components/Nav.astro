---
import { site } from "../config/site";
import IconSun from "./icons/IconSun.astro";
import IconMoon from "./icons/IconMoon.astro";
---

<header class="nav">
  <div class="nav__inner">
    <a href="/" class="nav__logo">{site.handle}</a>

    <nav class="nav__links" aria-label="Primary">
      {site.nav.map((item) => (
        <a href={item.href} class="nav__link">{item.label}</a>
      ))}
      {site.resume && (
        <a href={site.resume} class="nav__link nav__link--resume" target="_blank" rel="noopener">
          Resume ↗
        </a>
      )}
    </nav>

    <div class="nav__actions">
      {site.socials.github && (
        <a href={site.socials.github} class="nav__icon-link" target="_blank" rel="noopener noreferrer" aria-label="GitHub">
          <svg width="17" height="17" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0 1 12 6.844a9.59 9.59 0 0 1 2.504.337c1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.02 10.02 0 0 0 22 12.017C22 6.484 17.522 2 12 2z"/>
          </svg>
        </a>
      )}
      {site.socials.linkedin && (
        <a href={site.socials.linkedin} class="nav__icon-link" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
          </svg>
        </a>
      )}
      <button class="nav__theme-toggle" id="theme-toggle" aria-label="Toggle dark mode">
        <span class="icon icon--sun"><IconSun /></span>
        <span class="icon icon--moon"><IconMoon /></span>
      </button>
    </div>
  </div>
</header>

<script>
  const toggle = document.getElementById("theme-toggle")!;

  toggle.addEventListener("click", () => {
    const next = document.documentElement.dataset.theme === "dark" ? "light" : "dark";
    document.documentElement.dataset.theme = next;
    localStorage.setItem("theme", next);
  });
</script>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 50;
    background-color: var(--color-nav);
    height: var(--nav-height);
  }

  .nav__inner {
    max-width: var(--content-width);
    margin: 0 auto;
    padding: 0 1.5rem;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .nav__logo {
    font-family: var(--font-heading);
    font-size: 0.875rem;
    font-weight: 700;
    color: var(--color-nav-text);
    letter-spacing: 0.01em;
  }

  .nav__logo:hover {
    color: var(--color-nav-text);
  }

  .nav__links {
    display: flex;
    gap: 2rem;
    align-items: center;
    flex: 1;
    justify-content: center;
  }

  .nav__link {
    font-family: var(--font-body);
    font-size: 0.8125rem;
    font-weight: 400;
    color: var(--color-nav-link);
    transition: color 0.15s ease;
    letter-spacing: 0.01em;
  }

  .nav__link:hover {
    color: var(--color-nav-link-hover);
  }

  .nav__link--resume {
    color: var(--color-nav-link-hover);
    opacity: 0.8;
  }

  .nav__link--resume:hover {
    opacity: 1;
  }

  .nav__actions {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .nav__icon-link {
    display: flex;
    align-items: center;
    color: var(--color-nav-link);
    transition: color 0.15s ease;
    padding: 0.25rem;
  }

  .nav__icon-link:hover {
    color: var(--color-nav-link-hover);
  }

  .nav__theme-toggle {
    background: none;
    border: none;
    cursor: pointer;
    padding: 0.25rem;
    display: flex;
    align-items: center;
    color: var(--color-nav-link);
    transition: color 0.15s ease;
  }

  .nav__theme-toggle:hover {
    color: var(--color-nav-text);
  }

  /* Show moon in light mode, sun in dark mode */
  .icon--sun  { display: none; }
  .icon--moon { display: block; }

  :global([data-theme="dark"]) .icon--sun  { display: block; }
  :global([data-theme="dark"]) .icon--moon { display: none; }
</style>
