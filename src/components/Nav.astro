---
import { site } from "../config/site";
---

<header class="nav">
  <div class="nav__inner">
    <a href="/" class="nav__mark">{site.name}</a>

    <nav class="nav__links" aria-label="Primary">
      {site.nav.map((item) => (
        <a href={item.href} class="nav__link">{item.label}</a>
      ))}

      {site.socials.github && (
        <a href={site.socials.github} class="nav__link" target="_blank" rel="noopener noreferrer">GitHub</a>
      )}
      {site.socials.linkedin && (
        <a href={site.socials.linkedin} class="nav__link" target="_blank" rel="noopener noreferrer">LinkedIn</a>
      )}
    </nav>

    {site.resume && (
      <a href={site.resume} class="nav__cta" target="_blank" rel="noopener">Resume</a>
    )}
  </div>
</header>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgb(14 15 17 / 0.85);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--color-line);
  }

  .nav__inner {
    max-width: var(--content-width);
    margin: 0 auto;
    padding: 0 2rem;
    height: var(--nav-height);
    display: flex;
    align-items: center;
    gap: 2rem;
  }

  .nav__mark {
    font-family: var(--font-heading);
    font-size: 1.0625rem;
    font-weight: 600;
    letter-spacing: -0.015em;
    color: var(--color-heading);
  }

  .nav__mark:hover {
    color: var(--color-heading);
  }

  .nav__links {
    display: flex;
    gap: 1.6rem;
    margin-left: auto;
  }

  .nav__link {
    font-size: 0.8125rem;
    color: var(--color-muted);
  }

  .nav__link:hover {
    color: var(--color-heading);
  }

  .nav__cta {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--color-accent);
    border: 1px solid var(--color-accent-line);
    border-radius: 5px;
    padding: 0.3rem 0.7rem;
    white-space: nowrap;
  }

  .nav__cta:hover {
    background: var(--color-accent-wash);
  }

  @media (max-width: 700px) {
    .nav__inner { padding: 0 1.25rem; gap: 1rem; }
    .nav__links { gap: 1rem; }
  }

  @media (max-width: 520px) {
    .nav__links { gap: 0.9rem; font-size: 0.75rem; }
  }
</style>
