---
import Base from "./Base.astro";
import type { CollectionEntry } from "astro:content";

interface Props {
  project: CollectionEntry<"projects">;
}

const { project } = Astro.props;
const { title, description, date, tags, github, status } = project.data;

const formattedDate = new Date(date).toLocaleDateString("en-US", {
  year: "numeric",
  month: "long",
});
---

<Base title={title} description={description}>
  <article class="pp">
    <a href="/projects" class="pp__back">← Work</a>

    <div class="pp__top">
      <h1 class="pp__title">{title}</h1>
      {status && <span class={`badge badge--${status}`}>{status}</span>}
    </div>

    <p class="pp__desc">{description}</p>

    <div class="pp__meta">
      <span class="pp__date">{formattedDate}</span>
      {tags.map((tag) => <span class="pp__tag">{tag}</span>)}
      {github && (
        <a class="pp__github" href={github} target="_blank" rel="noopener noreferrer">↗ GitHub</a>
      )}
    </div>

    <div class="prose">
      <slot />
    </div>
  </article>
</Base>

<style>
  .pp {
    max-width: var(--prose-width);
    margin: 0 auto;
    padding: 3rem 2rem 5rem;
  }

  @media (max-width: 640px) { .pp { padding: 2rem 1.25rem 4rem; } }

  .pp__back {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    color: var(--color-muted);
  }

  .pp__back:hover { color: var(--color-accent); }

  .pp__top {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.875rem;
    margin: 1.25rem 0 0.6rem;
  }

  .pp__title {
    font-size: clamp(1.9rem, 5vw, 2.75rem);
    letter-spacing: -0.03em;
    margin: 0;
  }

  .pp__desc {
    margin: 0 0 1.25rem;
    font-size: 1.0625rem;
    color: var(--color-muted);
  }

  .pp__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem 0.75rem;
    padding-bottom: 2rem;
    border-bottom: 1px solid var(--color-line);
    margin-bottom: 2.5rem;
  }

  .pp__date {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--color-muted);
  }

  .pp__tag {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    background: var(--color-raised);
    border: 1px solid var(--color-line);
    color: var(--color-muted);
    padding: 0.18rem 0.5rem;
    border-radius: 4px;
  }

  .pp__github {
    font-family: var(--font-mono);
    font-size: 0.75rem;
  }
</style>
