---
import Base from "../layouts/Base.astro";
import Hero from "../components/Hero.astro";
import SectionHeader from "../components/SectionHeader.astro";
import ProjectCard from "../components/ProjectCard.astro";
import Footer from "../components/Footer.astro";
import { getCollection } from "astro:content";

const allProjects = await getCollection("projects", ({ data }) => !data.draft);
const featured = allProjects
  .filter((p) => p.data.featured)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<Base>
  <Hero />

  {featured.length > 0 && (
    <>
      <SectionHeader label="Featured Projects" />
      <section class="content-band">
        <div class="content-band__inner">
          <div class="project-grid">
            {featured.map((project, i) => (
              <div class="fade-in" style={`transition-delay: ${i * 0.07}s`}>
                <ProjectCard
                  title={project.data.title}
                  description={project.data.description}
                  tags={project.data.tags}
                  href={`/projects/${project.id}`}
                  github={project.data.github}
                  image={project.data.image}
                  status={project.data.status}
                />
              </div>
            ))}
          </div>
          <a href="/projects" class="see-all">All projects →</a>
        </div>
      </section>
    </>
  )}

  <Footer />
</Base>

<style>
  .content-band {
    padding: 1.5rem 0 3rem;
  }

  .content-band__inner {
    max-width: var(--content-width);
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  .project-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(17rem, 1fr));
    gap: 1rem;
    margin-bottom: 1.5rem;
  }

  /* ensure cards fill their fade-in wrappers */
  .project-grid .fade-in {
    display: flex;
    flex-direction: column;
  }

  .project-grid .fade-in > :global(.card) {
    flex: 1;
  }


  .see-all {
    font-family: var(--font-body);
    font-size: 0.8125rem;
    font-weight: 500;
    color: var(--color-accent);
  }

  .see-all:hover {
    color: var(--color-accent-hover);
  }
</style>
