---
import Base from "../layouts/Base.astro";
import Hero from "../components/Hero.astro";
import Fetch from "../components/Fetch.astro";
import ProjectSlab from "../components/ProjectSlab.astro";
import { getCollection } from "astro:content";

const featured = (await getCollection("projects", ({ data }) => !data.draft && data.featured))
  .sort((a, b) => {
    const ao = a.data.order ?? Infinity;
    const bo = b.data.order ?? Infinity;
    if (ao !== bo) return ao - bo;
    return b.data.date.valueOf() - a.data.date.valueOf();
  });
---

<Base>
  <Hero />
  <Fetch />

  {featured.length > 0 && (
    <section class="work" id="work">
      <div class="work__head">
        <h2>Projects</h2>
        <a href="/projects">All projects →</a>
      </div>

      {featured.map((project, i) => (
        <ProjectSlab
          title={project.data.title}
          description={project.data.description}
          tags={project.data.tags}
          href={`/projects/${project.id}`}
          image={project.data.image}
          status={project.data.status}
          index={i}
        />
      ))}
    </section>
  )}
</Base>

<style>
  .work {
    max-width: var(--content-width);
    margin: 0 auto;
    padding: 0 2rem 2rem;
  }

  @media (max-width: 640px) { .work { padding: 0 1.25rem 2rem; } }

  .work__head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1rem;
  }

  .work__head h2 {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--color-muted);
    font-weight: 400;
    margin: 0;
  }

  .work__head a {
    font-size: 0.8125rem;
    white-space: nowrap;
  }
</style>
