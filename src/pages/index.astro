---
import Base from "../layouts/Base.astro";
import Hero from "../components/Hero.astro";
import SectionHeader from "../components/SectionHeader.astro";
import ProjectCard from "../components/ProjectCard.astro";
import { getCollection } from "astro:content";

const allProjects = await getCollection("projects", ({ data }) => !data.draft);
const featured = allProjects
  .filter((p) => p.data.featured)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const recentPosts = (await getCollection("blog", ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);
---

<Base>
  <Hero />

  {featured.length > 0 && (
    <>
      <SectionHeader label="Featured Projects" />
      <section class="content-band">
        <div class="content-band__inner">
          <div class="project-grid">
            {featured.map((project) => (
              <ProjectCard
                title={project.data.title}
                description={project.data.description}
                tags={project.data.tags}
                href={`/projects/${project.id}`}
                github={project.data.github}
                image={project.data.image}
              />
            ))}
          </div>
          <a href="/projects" class="see-all">All projects →</a>
        </div>
      </section>
    </>
  )}

  {recentPosts.length > 0 && (
    <>
      <SectionHeader label="Recent Writing" />
      <section class="content-band">
        <div class="content-band__inner">
          <ul class="post-list">
            {recentPosts.map((post) => (
              <li class="post-list__item">
                <a href={`/blog/${post.id}`} class="post-list__title">
                  {post.data.title}
                </a>
                <span class="post-list__date">
                  {new Date(post.data.date).toLocaleDateString("en-US", {
                    year: "numeric",
                    month: "short",
                  })}
                </span>
              </li>
            ))}
          </ul>
          <a href="/blog" class="see-all">All posts →</a>
        </div>
      </section>
    </>
  )}
</Base>

<style>
  .content-band {
    background-color: var(--color-bg);
    padding: 2rem 0 2.5rem;
  }

  .content-band__inner {
    max-width: var(--content-width);
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  .project-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(17rem, 1fr));
    gap: 1rem;
    margin-bottom: 1.25rem;
  }

  .post-list {
    list-style: none;
    padding: 0;
    margin-bottom: 1.25rem;
  }

  .post-list__item {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
    padding: 0.625rem 0;
    border-bottom: 1px solid var(--color-divider);
  }

  .post-list__title {
    font-family: var(--font-heading);
    font-size: 0.9375rem;
    color: var(--color-text-heading);
  }

  .post-list__title:hover {
    color: var(--color-accent);
  }

  .post-list__date {
    font-family: var(--font-body);
    font-size: 0.75rem;
    color: var(--color-text-muted);
    white-space: nowrap;
  }

  .see-all {
    font-family: var(--font-body);
    font-size: 0.8125rem;
    color: var(--color-accent);
  }

  .see-all:hover {
    color: var(--color-accent-hover);
  }
</style>
