---
import Base from "../../layouts/Base.astro";
import SectionHeader from "../../components/SectionHeader.astro";
import { getCollection } from "astro:content";

const posts = (await getCollection("blog", ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<Base title="Blog">
  <SectionHeader label="Writing" />

  <main class="main">
    <ul class="post-list">
      {posts.map((post) => (
        <li class="post-list__item">
          <div class="post-list__meta">
            <span class="post-list__date">
              {new Date(post.data.date).toLocaleDateString("en-US", {
                year: "numeric",
                month: "short",
                day: "numeric",
              })}
            </span>
            {post.data.tags.length > 0 && (
              <div class="post-list__tags">
                {post.data.tags.map((tag) => (
                  <span class="post-list__tag">{tag}</span>
                ))}
              </div>
            )}
          </div>
          <a href={`/blog/${post.id}`} class="post-list__title">
            {post.data.title}
          </a>
          <p class="post-list__description">{post.data.description}</p>
        </li>
      ))}
    </ul>
  </main>
</Base>

<style>
  .main {
    max-width: var(--content-width);
    margin: 0 auto;
    padding: 2rem 1.5rem 5rem;
  }

  .post-list {
    list-style: none;
    padding: 0;
  }

  .post-list__item {
    padding: 1.5rem 0;
    border-bottom: 1px solid var(--color-divider);
  }

  .post-list__meta {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 0.375rem;
  }

  .post-list__date {
    font-family: var(--font-body);
    font-size: 0.75rem;
    color: var(--color-text-muted);
  }

  .post-list__tags {
    display: flex;
    gap: 0.25rem;
  }

  .post-list__tag {
    font-family: var(--font-body);
    font-size: 0.5625rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    background-color: var(--color-tag-bg);
    color: var(--color-tag-text);
    padding: 0.1rem 0.375rem;
    border-radius: 2px;
  }

  .post-list__title {
    font-family: var(--font-heading);
    font-size: 1.125rem;
    font-weight: 700;
    color: var(--color-text-heading);
    display: block;
    margin-bottom: 0.375rem;
  }

  .post-list__title:hover {
    color: var(--color-accent);
  }

  .post-list__description {
    font-family: var(--font-body);
    font-size: 0.875rem;
    line-height: 1.65;
    color: var(--color-text-muted);
  }
</style>
